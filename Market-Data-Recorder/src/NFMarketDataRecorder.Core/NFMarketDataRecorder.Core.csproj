<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so the assembly loads in the ATAS runtime (.NET Framework
         based today, .NET based in ATAS X) without a second build. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NFMarketDataRecorder.Core</AssemblyName>
    <RootNamespace>NFMarketDataRecorder.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- No PackageReference by design: the recorder must not drag dependencies
       into the ATAS process. JSON is written by a hand-rolled deterministic
       writer (see JsonLine.cs) for exactly that reason. -->

</Project>
