<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so this assembly loads in the ATAS runtime without a
         second build, whatever that runtime turns out to be. Both installed
         products measured .NETCoreApp 10.0 on 2026-09-12; Classic measured 8.0
         earlier the same day, which is exactly why this target is pinned to the
         lowest common denominator rather than to a runtime reading. Every .NET
         Core runtime from 2.0 up consumes netstandard2.0, so a platform upgrade
         underneath an install cannot invalidate it. It also keeps Core usable
         from the netstandard stub build. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NFMarketReplayRecorder.Core</AssemblyName>
    <RootNamespace>NFMarketReplayRecorder.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- No PackageReference by design: the recorder must not drag dependencies
       into the ATAS process. JSON is written by a hand-rolled deterministic
       writer (see JsonLine.cs) for exactly that reason. -->

</Project>
