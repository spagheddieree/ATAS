<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A DEVELOPMENT TOOL, not part of the shipped indicator.

    Reads the real ATAS assemblies' METADATA and reports what the API actually
    is, so the adapter can be corrected against fact instead of assumption.

    It is deliberately NOT in ReplayEventVerifier.sln: it never loads into the
    ATAS process, and Core must stay dependency-free.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>atas-api-probe</AssemblyName>
    <RootNamespace>ReplayEventVerifier.ApiProbe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Necessary, and the only dependency in the whole repository outside tests.
      The ATAS assemblies are .NET Framework; MetadataLoadContext is the only
      supported way to reflect over them from a .NET 8 process WITHOUT loading
      or executing them. Plain Assembly.LoadFrom would either fail to resolve
      their dependency graph or run their static initialisers inside this tool.
    -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

</Project>
